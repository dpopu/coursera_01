    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug executable 'error-handling'",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "run",
                    "--bin=error-handling"
                ]
            },
            "args": [
                "--input-file-name=my_file.txt"
            ]
        },
        {
            "name": "Debug unit tests in executable 'error-handling'",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "test",
                    "--bin=error-handling"
                ]
            }
        }
    ]
}